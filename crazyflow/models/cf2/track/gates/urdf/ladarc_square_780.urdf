<?xml version="1.0" ?>

<robot name="gate">

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="0 1.57 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../stl/gate.stl" scale="0.0008 0.0008 0.0008"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.35 0"/>
      <geometry>
        <box size="0.1 0.1 0.8"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.35 0"/>
      <geometry>
        <box size="0.1 0.1 0.8"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.35"/>
      <geometry>
        <box size="0.1 0.6 0.1"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.35"/>
      <geometry>
        <box size="0.1 0.6 0.1"/>
      </geometry>
    </collision>
  </link>

</robot>